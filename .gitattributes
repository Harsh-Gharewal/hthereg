# Normalize all text files to LF in the repo, checkout as-is on all platforms
* text=auto eol=lf

# Explicitly mark common source files as text with LF
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.ini   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.sh    text eol=lf

# Binary files — never touch line endings
*.parquet  binary
*.db       binary
*.png      binary
*.jpg      binary
*.ico      binary
*.woff2    binary
*.woff     binary
